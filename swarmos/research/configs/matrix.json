{
  "project": "SWARMOS-Robustness-Evaluation",
  "nebius_compute_cluster": "k8s-gpu-nemotron-west1",
  "instance_type": "standard-8-v100",
  "trials_per_config": 5,
  "parameter_sweep": {
    "fleet_size": [4, 8, 16, 32],
    "task_density": [10, 20],
    "failure_scenarios": [
      {
        "name": "nominal",
        "motor_failure_rate": 0.0,
        "rf_jamming_active": false,
        "packet_loss_rate": 0.0
      },
      {
        "name": "loss_10",
        "motor_failure_rate": 0.0,
        "rf_jamming_active": false,
        "packet_loss_rate": 0.10
      },
      {
        "name": "loss_25",
        "motor_failure_rate": 0.0,
        "rf_jamming_active": true,
        "packet_loss_rate": 0.25
      },
      {
        "name": "loss_50_catastrophic",
        "motor_failure_rate": 0.2,
        "rf_jamming_active": true,
        "packet_loss_rate": 0.50
      },
      {
        "name": "adversarial_nodes",
        "motor_failure_rate": 0.0,
        "rf_jamming_active": false,
        "packet_loss_rate": 0.10
      }
    ],
    "communication_ranges_m": [500]
  },
  "metrics_to_collect": [
    "time_to_consensus_ms",
    "mission_completion_rate_pct",
    "fleet_attrition_survival_pct",
    "re_auction_convergence_ms",
    "total_energy_consumed_wh",
    "communication_overhead_packets"
  ]
}
